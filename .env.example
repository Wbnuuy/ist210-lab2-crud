# ==============================================================================
# IST 210 Lab 2 - Database Configuration Environment Variables
# ==============================================================================

# Database Authentication Mode:
# Options:
#   - 'sql': Azure SQL / SQL Server with username and password
#   - 'windows': Local SQL Server / Domain with Windows Authentication (Trusted_Connection)
#   - 'azure_ad': Azure Active Directory / Microsoft Entra Interactive
#   - 'sqlite': Local SQLite database (ideal for instant offline testing and demonstration)
DB_AUTH_MODE=windows

# Azure SQL / SQL Server Host
DB_SERVER=thisisalab-ist210.database.windows.net

# Database Name (from Lab 1)
DB_DATABASE=ist210-db-dong

# Credentials (required if DB_AUTH_MODE=sql or azure_ad)
DB_USER=
DB_PASSWORD=

# ODBC Driver name (Microsoft ODBC Driver 17 for SQL Server is installed on this PC)
DB_DRIVER={ODBC Driver 17 for SQL Server}

# Connection Timeout (seconds)
DB_TIMEOUT=30

# SQLite fallback database file name (used when DB_AUTH_MODE=sqlite or when ODBC connection fails)
DB_SQLITE_FILE=ist210_lab.db

# Flask Application Settings
FLASK_APP=app.py
FLASK_ENV=development
FLASK_DEBUG=1
SECRET_KEY=ist210-lab2-secret-key-super-secure
PORT=5000
